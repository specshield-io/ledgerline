          }
        },
        "summary" : "List the chaos scenarios",
        "tags" : [ "Chaos" ]
      }
    },
    "/api/v1/chaos/scenarios/{name}" : {
      "post" : {
        "description" : "Creates a new synthetic order and drives it through the scenario with real signed MockPay webhooks. Returns at once; the run continues in the background.",
        "operationId" : "start",
        "parameters" : [ {
          "description" : "Unique key for this request (8-128 characters, [A-Za-z0-9_-]); repeating it returns the same run",
          "in" : "header",
          "name" : "Idempotency-Key",
          "required" : true,
          "schema" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 8,
            "pattern" : "[A-Za-z0-9_-]+"
          }
        }, {
          "description" : "happy-path, duplicate-storm, tampered-webhook, replay-attack, out-of-order, merchant-down, merchant-slow or refund-flow",
          "in" : "path",
          "name" : "name",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "202" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ScenarioRunStarted"
                }
              }
            },
            "description" : "Started (or the replayed response)",
            "headers" : {
              "Location" : {
                "description" : "The run",
                "style" : "simple"
              }
            }
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Unknown scenario"
          },
          "429" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Too many runs in progress, or too many starts from this client (Retry-After)"
          },
          "503" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "The deployment lacks MockPay or the demo merchant this scenario needs"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Error"
          }
        },
        "summary" : "Start a chaos scenario",
        "tags" : [ "Chaos" ]
      }
    },

{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "Order and payment event processing. SpecShield Labs internal demonstration: synthetic data only, not a production payment system, not PCI DSS scoped. The data is reset every night at 03:00 UTC.\n\nState-changing POST requests require an `Idempotency-Key` header (8-128 characters, `[A-Za-z0-9_-]`). Repeating a request with the same key and body replays the stored response with `Idempotent-Replayed: true`. Every error is RFC 9457 `application/problem+json`. Public endpoints are rate limited per client (60 requests per minute; 10 chaos scenario starts per minute); over the limit the answer is 429 with `Retry-After`.",
    "license" : {
      "name" : "Apache-2.0",
      "url" : "https://www.apache.org/licenses/LICENSE-2.0"
    },
    "title" : "Ledgerline API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/",
    "description" : "This deployment"
  } ],
  "tags" : [ {
    "description" : "Start a failure scenario on a fresh synthetic order and watch its timeline. Public, limited to 10 starts per minute per client and 3 runs in progress at once.",
    "name" : "Chaos"
  }, {
    "description" : "Inspect merchant notifications and replay dead ones",
    "name" : "Outbox administration"
  }, {
    "description" : "Inbound provider webhooks (called by MockPay, not by clients)",
    "name" : "Webhooks"
  }, {
    "description" : "Reset the synthetic demo data",
    "name" : "Demo administration"
  }, {
    "description" : "About this deployment",
    "name" : "Meta"
  }, {
    "description" : "Create, read, pay and cancel orders",
    "name" : "Orders"
  } ],
  "paths" : {
    "/api/v1/admin/outbox" : {
      "get" : {
        "operationId" : "list_1",
        "parameters" : [ {
          "description" : "Only messages in this status",
          "in" : "query",
          "name" : "status",
          "required" : false,
          "schema" : {
            "type" : "string",
            "enum" : [ "PENDING", "IN_FLIGHT", "DELIVERED", "DEAD" ]
          }
        }, {
          "description" : "Zero-based page number",
          "in" : "query",
          "name" : "page",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0,
            "minimum" : 0
          }
        }, {
          "description" : "Page size, at most 100",
          "in" : "query",
          "name" : "size",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 20,
            "maximum" : 100,
            "minimum" : 1
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/OutboxPage"
                }
              }
            },
            "description" : "A page of outbox messages"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Invalid status, page or size"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Error"
          }
        },
        "security" : [ {
          "basicAuth" : [ ]
        } ],
        "summary" : "List outbox messages, newest first (VIEWER or ADMIN)",
        "tags" : [ "Outbox administration" ]
      }
    },
    "/api/v1/admin/outbox/{id}/replay" : {
      "post" : {
        "description" : "Moves a DEAD message back to PENDING with its attempts reset; the dispatcher delivers it again. ADMIN only. Writes an OUTBOX_REPLAYED audit row with actor operator:<user>.",
        "operationId" : "replay",
        "parameters" : [ {
          "description" : "Unique key for this request (8-128 characters, [A-Za-z0-9_-])",
          "in" : "header",
          "name" : "Idempotency-Key",
          "required" : true,
          "schema" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 8,
            "pattern" : "[A-Za-z0-9_-]+"
          }
        }, {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/OutboxMessage"
                }
              }
            },
            "description" : "The message, now PENDING (or the replayed response)"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Missing or invalid Idempotency-Key"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Outbox message not found"
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "The message is not DEAD, or a request with this key is in progress"
          },
          "422" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Idempotency-Key reused with a different request"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Error"
          }
        },
        "security" : [ {
          "basicAuth" : [ ]
        } ],
        "summary" : "Replay a DEAD message",
        "tags" : [ "Outbox administration" ]
      }
    },
    "/api/v1/admin/reset" : {
      "post" : {
        "description" : "Truncates orders, inbox, audit log, outbox and the MockPay ledger, then seeds 25 synthetic orders. Same lock as the nightly 03:00 UTC reset; idempotent.",
        "operationId" : "resetDemoData",
        "parameters" : [ {
          "description" : "Unique key for this request (8-128 characters, [A-Za-z0-9_-])",
          "in" : "header",
          "name" : "Idempotency-Key",
          "required" : true,
          "schema" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 8,
            "pattern" : "[A-Za-z0-9_-]+"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DemoReset"
                }
              }
            },
            "description" : "Reset done"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "No or wrong credentials"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Not an ADMIN"
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "A reset is already running"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Error"
          }
        },
        "security" : [ {
          "basicAuth" : [ ]
        } ],
        "summary" : "Wipe and reseed the demo data (ADMIN)",
        "tags" : [ "Demo administration" ]
      }
    },
    "/api/v1/chaos/runs/{id}" : {
      "get" : {
        "operationId" : "run",
        "parameters" : [ {

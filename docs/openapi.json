                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/TimelineEntry"
                  }
                }
              }
            },
            "description" : "Timeline entries, oldest first"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Order not found"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Error"
          }
        },
        "summary" : "Audit log and provider events for an order, oldest first",
        "tags" : [ "Orders" ]
      }
    },
    "/webhooks/mockpay" : {
      "post" : {
        "description" : "Signed with MockPay-Signature: t=<unix seconds>,v1=<hex HMAC-SHA256 of \"t.body\">. Duplicates are acknowledged with 200 and duplicate=true so the provider stops retrying.",
        "operationId" : "receive",
        "parameters" : [ {
          "description" : "t=<unix seconds>,v1=<hex>[,v1=<hex>]",
          "in" : "header",
          "name" : "MockPay-Signature",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "type" : "string",
                "format" : "byte"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/WebhookAck"
                }
              }
            },
            "description" : "Received (applied, duplicate, ignored, orphan or waiting)"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "invalid-signature or malformed-event"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Processing failed and was rolled back; the provider should retry"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Error"
          }
        },
        "summary" : "Receive a MockPay event",
        "tags" : [ "Webhooks" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "ChaosScenario" : {
        "type" : "object",
        "properties" : {
          "description" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string",
            "example" : "duplicate-storm"
          }
        }
      },
      "CreateOrderRequest" : {
        "type" : "object",
        "description" : "A new order. Synthetic data only.",
        "properties" : {
          "amountMinor" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Amount in minor units (cents)",
            "example" : 2599,
            "maximum" : 100000000,
            "minimum" : 1
          },
          "currency" : {
            "type" : "string",
            "description" : "ISO 4217 currency; only USD is supported",
            "enum" : [ "USD" ],
            "example" : "USD",
            "pattern" : "USD"
          },
          "merchantRef" : {
            "type" : "string",
            "description" : "Merchant's own reference for the order",
            "example" : "synthetic-order-1001",
            "maxLength" : 64,
            "minLength" : 0
          }
        },
        "required" : [ "amountMinor", "currency", "merchantRef" ]
      },
      "DemoReset" : {
        "type" : "object",
        "properties" : {
          "reset" : {
            "type" : "boolean"
          },
          "seededOrders" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "Meta" : {
        "type" : "object",
        "description" : "Banner data for UIs",
        "properties" : {
          "dataResetsAt" : {
            "type" : "string",
            "example" : "03:00 UTC"
          },
          "demo" : {
            "type" : "boolean",
            "description" : "Always true: synthetic data only"
          },
          "gitSha" : {
            "type" : "string",
            "description" : "Commit of this build, or 'unknown'"
          },
          "version" : {
            "type" : "string",
            "example" : "0.1.0-SNAPSHOT"
          }
        }
      },
      "Order" : {
        "type" : "object",
        "properties" : {
          "amountMinor" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Amount in minor units (cents)"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "currency" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "lastProviderEventAt" : {
            "type" : [ "string", "null" ],
            "format" : "date-time",
            "description" : "Provider timestamp of the last applied payment event"
          },
          "merchantRef" : {
            "type" : "string"
          },
          "refundedMinor" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Refunded so far, in minor units"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "CREATED", "PAYMENT_PENDING", "PAID", "PAYMENT_FAILED", "PARTIALLY_REFUNDED", "REFUNDED", "CANCELLED" ]
          },
          "updatedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "version" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Optimistic-locking version; increases on every change"
          }
        }
      },
      "OrderPage" : {
        "type" : "object",
        "description" : "Orders, newest first",
        "properties" : {
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Order"
            }
          },
          "page" : {
            "type" : "integer",
            "format" : "int32"
          },
          "size" : {
            "type" : "integer",
            "format" : "int32"
          },
          "totalElements" : {
            "type" : "integer",
            "format" : "int64"
          },
          "totalPages" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "OutboxMessage" : {
        "type" : "object",
        "description" : "A merchant notification in the transactional outbox",
        "properties" : {
          "aggregateId" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "The order the notification is about"
          },
          "attempts" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Delivery attempts made so far"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "deliveredAt" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "eventType" : {
            "type" : "string",
            "example" : "order.paid"
          },
          "id" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Outbox id; sent to the merchant as Ledgerline-Event-Id"
          },
          "lastError" : {
            "type" : [ "string", "null" ],
            "description" : "Error of the last failed attempt"
          },
          "nextAttemptAt" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "When the next attempt is due (PENDING)"
          },
          "payload" : {
            "type" : "object",
            "description" : "Notification data"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "PENDING", "IN_FLIGHT", "DELIVERED", "DEAD" ]
          }
        }
      },
      "OutboxPage" : {
        "type" : "object",
        "description" : "Outbox messages, newest first",
        "properties" : {
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/OutboxMessage"
            }
          },
          "page" : {
            "type" : "integer",
            "format" : "int32"
          },
          "size" : {
            "type" : "integer",
            "format" : "int32"
          },
          "totalElements" : {
            "type" : "integer",
            "format" : "int64"
          },
          "totalPages" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "PaymentRequest" : {
        "type" : "object",
        "description" : "The payment was requested from MockPay. The order status changes when MockPay reports events.",
        "properties" : {
          "orderId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "paymentReference" : {
            "type" : "string",
            "description" : "MockPay's reference for the payment",
            "example" : "mp_stub_0194a1b2-..."
          },
          "status" : {
            "type" : "string",
            "description" : "Order status at the time of the request (unchanged by it)",
            "enum" : [ "CREATED", "PAYMENT_PENDING", "PAID", "PAYMENT_FAILED", "PARTIALLY_REFUNDED", "REFUNDED", "CANCELLED" ]
          }
        }
      },
      "Problem" : {
        "type" : "object",
        "additionalProperties" : true,
        "description" : "RFC 9457 problem details. Branch on `type`, never on `title` or `detail`.",
        "properties" : {
          "correlationId" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "Echo of X-Request-Id"
          },
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri-reference"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32",
            "example" : 404
          },
          "title" : {
            "type" : "string",
            "example" : "Order not found"
          },
          "type" : {
            "type" : "string",
            "format" : "uri",
            "example" : "urn:ledgerline:problem:order-not-found"
          }
        },
        "required" : [ "type", "title", "status", "detail", "instance" ]
      },
      "ScenarioRun" : {
        "type" : "object",
        "properties" : {
          "error" : {
            "type" : [ "string", "null" ]
          },
          "finishedAt" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "orderId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "orderStatus" : {
            "type" : [ "string", "null" ],
            "description" : "Order status when the run finished"
          },
          "scenario" : {
            "type" : "string"
          },
          "scenarioRunId" : {
            "type" : "string"
          },
          "startedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "RUNNING", "COMPLETED", "FAILED" ]
          },
          "steps" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ScenarioRunStep"
            }
          }
        }
      },
      "ScenarioRunStarted" : {
        "type" : "object",
        "properties" : {
          "orderId" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "The order this run created; poll GET /api/v1/orders/{orderId}/timeline"
          },
          "scenario" : {
            "type" : "string",
            "example" : "duplicate-storm"
          },
          "scenarioRunId" : {
            "type" : "string",
            "description" : "Poll GET /api/v1/chaos/runs/{scenarioRunId}"
          }
        }
      },
      "ScenarioRunStep" : {
        "type" : "object",
        "properties" : {
          "at" : {
            "type" : "string",
            "format" : "date-time"
          },
          "description" : {
            "type" : "string"
          },
          "httpStatus" : {
            "type" : [ "integer", "null" ],
            "format" : "int32",
            "description" : "The webhook receiver's answer, for deliveries"
          }
        }
      },
      "TimelineEntry" : {
        "type" : "object",
        "description" : "An audit log entry or a provider event, ordered by time",
        "properties" : {
          "actor" : {
            "type" : "string",
            "description" : "Who acted: 'api' or the provider name"
          },
          "at" : {
            "type" : "string",
            "format" : "date-time"
          },
          "correlationId" : {
            "type" : [ "string", "null" ]
          },
          "detail" : {
            "type" : "object",
            "description" : "Audit detail or provider payload"
          },
          "kind" : {
            "type" : "string",
            "description" : "Audit kind, e.g. ORDER_CREATED, or PROVIDER_EVENT",

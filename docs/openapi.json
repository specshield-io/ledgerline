          },
          "outcome" : {
            "type" : [ "string", "null" ],
            "description" : "Inbox processing outcome"
          },
          "providerEventId" : {
            "type" : [ "string", "null" ]
          },
          "source" : {
            "type" : "string",
            "description" : "AUDIT (our own commands) or INBOX (provider events)",
            "enum" : [ "AUDIT", "INBOX" ]
          }
        }
      },
      "WebhookAck" : {
        "type" : "object",
        "properties" : {
          "duplicate" : {
            "type" : [ "boolean", "null" ],
            "description" : "Present and true when the event was already stored"
          },
          "received" : {
            "type" : "boolean"
          }
        }
      }
    },
    "securitySchemes" : {
      "basicAuth" : {
        "description" : "Admin endpoints: VIEWER may list, ADMIN may change.",
        "scheme" : "basic",
        "type" : "http"
      }
    }

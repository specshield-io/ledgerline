<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Aggregator only. It exists so that `./mvnw verify` works from the repository root.
      All build configuration lives in ledgerline-api/pom.xml, which inherits from spring-boot-starter-parent.
      ops-console (React) is built with npm, not Maven.
    -->
    <groupId>com.specshield.ledgerline</groupId>
    <artifactId>ledgerline</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Ledgerline</name>
    <description>SpecShield Labs internal engineering demonstration. Synthetic data only.</description>

    <modules>
        <module>ledgerline-api</module>
    </modules>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                  Declared here only so the `pitest:` and `spotless:` prefixes resolve from the root.
                  Both are configured in ledgerline-api/pom.xml; keep these versions in sync with it.
                -->
                <plugin>
                    <groupId>org.pitest</groupId>
                    <artifactId>pitest-maven</artifactId>
                    <version>1.30.2</version>
                </plugin>
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>3.12.0</version>
                    <configuration>
                        <!-- Nothing to format in the aggregator itself. -->
                        <skip>true</skip>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
